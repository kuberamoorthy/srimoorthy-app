// Prisma Schema for Sri Moorthy Transport Fleet Manager
// Configured for Supabase PostgreSQL with PgBouncer connection pooling

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. VEHICLES MODEL
model Vehicle {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.Text
  number    String    @unique @db.Text
  type      String    @db.Text
  status    String    @default("active") @db.Text
  color     String    @default("#EF5226") @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  bills     Bill[]
  fuelLogs  FuelLog[]
  salaries  DriverSalary[]

  @@map("vehicles")
}

// 2. BILLS MODEL
model Bill {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billNumber    String    @unique @map("bill_number") @db.Text
  date          DateTime  @db.Date
  vehicleId     String?   @map("vehicle_id") @db.Uuid
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customerName       String?   @default("Local Customer") @map("customer_name") @db.Text
  customerPhone      String?   @map("customer_phone") @db.Text
  fromLocation       String    @map("from_location") @db.Text
  toLocation         String    @map("to_location") @db.Text
  goodsDesc          String?   @map("goods_desc") @db.Text
  isLocalIncome      Boolean   @default(false) @map("is_local_income")
  addToDriverSalary  Boolean   @default(false) @map("add_to_driver_salary")
  driverName         String?   @map("driver_name") @db.Text
  driverSalaryAmount Decimal   @default(0) @map("driver_salary_amount") @db.Decimal(12, 2)
  driverSalaryStatus String?   @default("paid") @map("driver_salary_status") @db.Text
  lineItems          Json?     @default("[]") @map("line_items")
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  gstPercent    Decimal   @default(0) @map("gst_percent") @db.Decimal(5, 2)
  gst           Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal   @default(0) @map("grand_total") @db.Decimal(12, 2)
  amountPaid    Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balance       Decimal   @default(0) @db.Decimal(12, 2)
  paymentStatus String    @default("unpaid") @map("payment_status") @db.Text
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("bills")
}

// 3. FUEL LOGS MODEL
model FuelLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime  @db.Date
  vehicleId   String?   @map("vehicle_id") @db.Uuid
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  station     String?   @db.Text
  fuelType    String    @default("diesel") @map("fuel_type") @db.Text
  litres      Decimal   @db.Decimal(10, 2)
  rate        Decimal   @db.Decimal(10, 2)
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  odometer    Decimal?  @db.Decimal(12, 0)
  driver      String?   @db.Text
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("fuel_logs")
}

// 4. DRIVER SALARIES MODEL
model DriverSalary {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime  @db.Date
  driverName String    @map("driver_name") @db.Text
  amount     Decimal   @db.Decimal(12, 2)
  status     String    @default("paid") @db.Text
  vehicleId  String?   @map("vehicle_id") @db.Uuid
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("driver_salaries")
}

// 5. APP SETTINGS MODEL
model AppSetting {
  key       String    @id @db.Text
  value     Json
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("app_settings")
}
